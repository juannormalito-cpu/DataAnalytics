# Plantilla para los "Secrets" de Streamlit Community Cloud (Settings → Secrets de tu app).
# NO es el archivo real — copiá estas claves con tus valores reales en la UI de Streamlit
# Cloud, o en un `.streamlit/secrets.toml` local (gitignored) si querés probarlo así.

DATABASE_URL = "postgresql://usuario:password@host/db?sslmode=require"
LOG_LEVEL = "INFO"
COMMODITY_API_KEY = ""
